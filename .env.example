# Docker Compose settings
# Address the published port listens on. 127.0.0.1 keeps Torrentinel on this machine (for example
# behind a reverse proxy on the same host); use 0.0.0.0 or a LAN address to open it from other devices.
TORRENTINEL_BIND_ADDRESS=127.0.0.1
TORRENTINEL_PORT=8080
PUBLIC_URL=http://localhost:8080
# Other domain names Torrentinel is opened under besides PUBLIC_URL's, comma-separated.
# IP addresses and local names such as "nas" or "nas.lan" always work.
ALLOWED_HOSTS=
# Optional password for the first administrator account; when empty, one is generated.
INITIAL_ADMIN_PASSWORD=
POLL_INTERVAL_MINUTES=60
POLL_STARTUP_DELAY_SECONDS=20
TRACKER_REQUEST_TIMEOUT_MS=30000
BROWSER_TIMEOUT_MS=120000
BROWSER_HEADLESS=false
BROWSER_CHANNEL=auto
BROWSER_SANDBOX=auto
SESSION_DAYS=30
SESSION_COOKIE_SECURE=false
TRUST_PROXY=false

# Tracker credentials and Telegram bot tokens are configured in Settings and
# encrypted in SQLite. They are intentionally not environment variables.
