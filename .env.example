# Docker Compose settings
TORRENTINEL_PORT=8080
PUBLIC_URL=http://localhost:8080
POLL_INTERVAL_MINUTES=60
POLL_STARTUP_DELAY_SECONDS=20
TRACKER_REQUEST_TIMEOUT_MS=30000
FLARESOLVERR_TIMEOUT_MS=120000
SESSION_DAYS=30
SESSION_COOKIE_SECURE=false

# Tracker credentials and Telegram bot tokens are configured in Settings and
# encrypted in SQLite. They are intentionally not environment variables.
