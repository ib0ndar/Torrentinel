# Rootless Podman settings
# Address reachable from your Telegram client for Magnet and Subscription buttons.
# Use your domain or server IP with its published port, e.g. http://192.168.1.50:8999.
PUBLIC_URL=http://localhost:8999
# Other domain names Torrentinel is opened under besides PUBLIC_URL's, comma-separated.
ALLOWED_HOSTS=
POLL_INTERVAL_MINUTES=60
POLL_STARTUP_DELAY_SECONDS=20
TRACKER_REQUEST_TIMEOUT_MS=30000
BROWSER_TIMEOUT_MS=120000
BROWSER_HEADLESS=false
BROWSER_CHANNEL=auto
BROWSER_SANDBOX=auto
SESSION_DAYS=30
SESSION_COOKIE_SECURE=false
TRUST_PROXY=false
