[Unit]
Description=Torrentinel integrated-browser canary
Wants=network-online.target
After=network-online.target

[Container]
Image=localhost/torrentinel:v0.5.0-integrated.1
ContainerName=torrentinel-integrated
UserNS=keep-id
PublishPort=8999:8080/tcp
Volume=torrentinel-integrated-app.volume:/var/lib/torrentinel:Z,U
Volume=torrentinel-integrated-db.volume:/data:Z,U
HealthCmd=node -e "fetch('http://127.0.0.1:8080/api/health').then(r=>{if(!r.ok)process.exit(1)}).catch(()=>process.exit(1))"
HealthInterval=30s
HealthTimeout=5s
HealthStartPeriod=20s
HealthRetries=3
HealthOnFailure=kill
ShmSize=512m
EnvironmentFile=./torrentinel-integrated.env

[Service]
Restart=always
TimeoutStartSec=900

[Install]
WantedBy=default.target
