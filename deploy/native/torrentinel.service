[Unit]
Description=Torrentinel release monitor
Wants=network-online.target
After=network-online.target

[Service]
Type=simple
User=torrentinel
Group=torrentinel
WorkingDirectory=/opt/torrentinel
Environment=NODE_ENV=production
EnvironmentFile=/etc/torrentinel/torrentinel.env
ExecStart=/usr/bin/env node dist/server/index.js
Restart=on-failure
RestartSec=5
UMask=0077
NoNewPrivileges=true
PrivateTmp=true
ProtectHome=true
ProtectSystem=strict
ReadWritePaths=/var/lib/torrentinel

[Install]
WantedBy=multi-user.target
