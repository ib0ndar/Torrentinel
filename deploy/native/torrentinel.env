# Native Linux production settings
HOST=127.0.0.1
PORT=8080
PUBLIC_URL=http://localhost:8080
DATA_DIR=/var/lib/torrentinel/database
APP_DATA_DIR=/var/lib/torrentinel/application
POLL_INTERVAL_MINUTES=60
POLL_STARTUP_DELAY_SECONDS=20
TRACKER_REQUEST_TIMEOUT_MS=30000
BROWSER_TIMEOUT_MS=120000
BROWSER_HEADLESS=true
BROWSER_CHANNEL=auto
SESSION_DAYS=30
SESSION_COOKIE_SECURE=false
