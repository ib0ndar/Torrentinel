[Unit]
Description=Private RuTracker detail resolver
Wants=network-online.target
After=network-online.target

[Container]
Image=ghcr.io/flaresolverr/flaresolverr:v3.5.0
ContainerName=torrentinel_flaresolverr
Network=torrentinel.network
NetworkAlias=flaresolverr
Environment=LOG_LEVEL=info
Environment=LOG_HTML=false
Environment=TZ=UTC
HealthCmd=curl -fsS http://127.0.0.1:8191/health
HealthInterval=30s
HealthTimeout=10s
HealthStartPeriod=90s
HealthRetries=3
Notify=healthy
ShmSize=512m
Tmpfs=/config:rw,size=64m,mode=0700

[Service]
Restart=always
TimeoutStartSec=180

[Install]
WantedBy=default.target
