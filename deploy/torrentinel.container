[Unit]
Description=Torrentinel release monitor
Wants=network-online.target
After=network-online.target

[Container]
Image=docker.io/bah0/torrentinel:v0.5.2
ContainerName=torrentinel
UserNS=keep-id
PublishPort=8999:8080/tcp
Volume=torrentinel_app.volume:/var/lib/torrentinel:Z,U
Volume=torrentinel_db.volume:/data:Z,U
HealthCmd=node -e "fetch('http://127.0.0.1:8080/api/health').then(r=>{if(!r.ok)process.exit(1)}).catch(()=>process.exit(1))"
HealthInterval=30s
HealthTimeout=5s
HealthStartPeriod=20s
HealthRetries=3
HealthOnFailure=kill
ShmSize=512m
EnvironmentFile=./torrentinel.env

[Service]
Restart=always
TimeoutStartSec=900

[Install]
WantedBy=default.target
